{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "subject-case": [
      1,
      "never",
      ["sentence-case", "start-case", "pascal-case", "upper-case"]
    ],
    "header-max-length": [1, "always", 100],
    "body-max-line-length": [1, "always", 100],
    "footer-max-line-length": [1, "always", 100]
  }
}
